rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validCourse(id) {
      return id.matches('([1-9]|[1-3][0-9]|4[0-2]|E0[1-9]|E1[0-2])');
    }
    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasAll(['status', 'grade', 'date', 'updatedAt'])
        && d.keys().hasOnly(['status', 'grade', 'date', 'updatedAt'])
        && d.status in ['pending', 'studying', 'regular', 'approved']
        && (d.grade == null || (d.grade is number && d.grade >= 1 && d.grade <= 10))
        && d.date is string
        && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.updatedAt is number && d.updatedAt >= 0;
    }
    match /users/{uid}/courses/{courseId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validCourse(courseId) && validRecord();
      allow delete: if owns(uid);
    }
    match /users/{uid}/profile/progress {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['ppsHours', 'industrialManagement'])
        && request.resource.data.keys().hasOnly(['ppsHours', 'industrialManagement'])
        && request.resource.data.ppsHours is int
        && request.resource.data.ppsHours >= 0
        && request.resource.data.ppsHours <= 10000
        && request.resource.data.industrialManagement is bool;
      allow delete: if owns(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
